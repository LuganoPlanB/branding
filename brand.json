    "layout": "tokens/layout.css",
    "provenance": "provenance.json",
    "assetNotes": "assets/README.md",
    "slideGuide": "slides/README.md",
    "slideStarter": "slides/planb-starter.pptx",
    "slideTemplate": "slides/planb-template.potx",
    "slidePreview": "slides/planb-preview.pdf",
    "slideStarterLight": "slides/planb-starter-light.pptx",
    "slideTemplateLight": "slides/planb-template-light.potx",
    "slidePreviewLight": "slides/planb-preview-light.pdf",
    "slideStarterDark": "slides/planb-starter-dark.pptx",
    "slideTemplateDark": "slides/planb-template-dark.potx",
    "slidePreviewDark": "slides/planb-preview-dark.pdf",
