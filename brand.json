    "Honor keyboard access, visible focus and reduced motion."
  ],
  "newGeometry": [
    "assets/shapes/signal.svg",
    "assets/shapes/energy-band.svg"
  ],
  "rights": "Original assets retain existing rights; no new blanket trademark or third-party license is granted.",
  "projects": [
    {
      "name": "Bitcoin Roots",
