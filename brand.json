    "exceptionalSignal": "--planb-color-highlight",
    "energy": "--planb-gradient-rainbow"
  },
  "rules": [
    "Prefer solid-color headings and readable text on solid grounds.",
    "Use one exceptional signal: gold or a coordinated electric gradient.",
