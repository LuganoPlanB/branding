  "narrative": {
    "northStar": "Civic Digital Commons",
    "overview": "An open, capable, curious and grounded civic identity. Warm reading surfaces, strong Inter typography and restrained color make public technology approachable; a small electric gesture supplies energy. This is the inherited Civic Digital Commons, confirmed for code-first documentation, not a replacement identity.",
    "keyCharacteristics": [
      "Warm canvas and navy structure.",
      "Weight before ornament; open sections before extra containers.",
      "One coordinated energy signal, with accessible semantic alternatives."
    ],
    "rules": [
      {
        "name": "The One Signal Rule",
        "body": "Choose gold or a gradient as the exceptional signal; keep text on a solid readable ground.",
        "section": "colors"
      },
      {
        "name": "The Intact Mark Rule",
        "body": "Preserve original artwork and choose its ground: color and white variants on navy; black variants on pale canvas.",
        "section": "components"
      }
    ],
    "dos": [
      "Do preserve original SVG bytes, proportions and view boxes.",
      "Do use navy grounds for color and white marks, and pale grounds for black marks.",
      "Do retain visible keyboard focus and readable contrast in both themes.",
      "Do distinguish extracted theme values from layout recommendations."
    ],
    "donts": [
      "Don't recolor, crop, stretch or add effects to original marks.",
      "Don't use Civic Sky as ordinary text on white.",
